# ContentOS / PubliQ

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Local Supabase (opcional; o CLI injeta automaticamente nas Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Billing
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_AGENCY=
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=

# Social
# META_APP_ID=
# META_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Auth Google (habilite [auth.external.google] no supabase/config.toml)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
