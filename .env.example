# PubliQ — modo de integração (servidor e cliente leem a mesma variável)
# mock: fixtures determinísticas, sem credenciais externas
# real: adapters conectam Supabase, Gemini, Mercado Pago, Upstash e Meta
NEXT_PUBLIC_INTEGRATION_MODE=mock

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Supabase (modo real)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Gemini (modo real)
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash

# Mercado Pago (modo real)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Upstash QStash + Redis (modo real)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meta (modo real)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_TOKEN_ENCRYPTION_KEY=

# Observabilidade (opcional)
SENTRY_DSN=
